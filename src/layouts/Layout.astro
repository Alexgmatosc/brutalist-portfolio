---
export interface Props {
    lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="utf-8"/><meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>alexmatos.dev | Portfolio</title>
    <script is:inline>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'light') {
                document.documentElement.classList.add('light');
            }
        })();
    </script>
    <style>@layer base{html,body{margin:0;padding:0;background-color:var(--bg-background);}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=JetBrains+Mono:wght@400;700&amp;family=Space+Mono:wght@700&amp;family=Pirata+One&amp;display=swap" rel="stylesheet"/><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/><script src="https://cdn.tailwindcss.com" is:inline></script>
<script id="tailwind-config" is:inline>
tailwind.config = {
  darkMode: "class",
  theme: {
    extend: {
      colors: {
        "primary": "#c82a2a",
        "primary-container": "#c82a2a",
        "background": "var(--bg-background)",
        "surface": "var(--bg-surface)",
        "surface-container": "var(--bg-surface-container)",
        "on-surface": "var(--text-on-surface)",
        "on-surface-variant": "var(--text-on-surface-variant)",
      },
      borderRadius: { DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", full: "9999px" },
      spacing: { gutter: "max(24px, 8vw)", "margin-page": "40px", "stack-gap": "16px", "grid-unit": "8px", "border-thin": "1px", "border-thick": "4px" },
      fontFamily: {
        "display-lg": ["Playfair Display", "serif"],
        "code-body": ["JetBrains Mono"],
        "terminal-small": ["JetBrains Mono"],
        "mono-label": ["Space Mono"],
        "headline-lg-mobile": ["Playfair Display", "serif"],
        "headline-lg": ["Playfair Display", "serif"],
        "headline-xl": ["Playfair Display", "serif"],
        "pirata": ["Pirata One", "cursive"]
      },
      fontSize: {
        "display-lg": ["120px", { lineHeight: "100px", letterSpacing: "-0.02em", fontWeight: "400" }],
        "code-body": ["16px", { lineHeight: "24px", fontWeight: "400" }],
        "terminal-small": ["14px", { lineHeight: "20px", fontWeight: "400" }],
        "mono-label": ["12px", { lineHeight: "16px", fontWeight: "700" }],
        "headline-lg-mobile": ["32px", { lineHeight: "32px", fontWeight: "400" }],
        "headline-lg": ["48px", { lineHeight: "48px", fontWeight: "400" }],
        "headline-xl": ["72px", { lineHeight: "72px", fontWeight: "400" }]
      }
    }
  }
}
</script>
<style is:global>
:root {
  --bg-background: #0d0d0d;
  --bg-surface: #121212;
  --bg-surface-container: #161616;
  --text-on-surface: #e0e0e0;
  --text-on-surface-variant: #888888;
}
.light {
  --bg-background: #fdfcf0;
  --bg-surface: #f5f2e6;
  --bg-surface-container: #e6e2d3;
  --text-on-surface: #1a1a1a;
  --text-on-surface-variant: #555555;
}
.bg-grid-pattern {
  background-image: linear-gradient(to right, rgba(200, 42, 42, 0.1) 1px, transparent 1px),
                    linear-gradient(to bottom, rgba(200, 42, 42, 0.1) 1px, transparent 1px);
  background-size: 24px 24px;
}
.scanlines {
  background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.2));
  background-size: 100% 4px;
}
.acid-border {
  border: 1px dashed rgba(255, 0, 0, 0.5);
}
</style>
</head>
<body class="bg-background font-code-body text-on-surface">
    <slot />
</body>
</html>
