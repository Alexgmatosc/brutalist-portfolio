---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ id }) => {
        return id.startsWith('es/');
    });
    
    return posts.map(post => ({
        params: { slug: post.id.replace('es/', '') },
        props: { post }
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`alexmatos.dev | ${post.data.title}`} description={post.data.description}>
    <Header lang="es" />
    
    <main class="pt-32 pb-16 min-h-screen px-gutter">
        <div class="max-w-4xl mx-auto">
            <a href="/blog" class="font-mono-label text-sm text-on-surface-variant hover:text-primary transition-colors mb-8 inline-block">
                &lt; VOLVER AL BLOG
            </a>
            
            <article class="bg-surface border-border-thick border-primary-container p-6 md:p-12 mt-6">
                <header class="mb-12 border-b-2 border-primary-container pb-8">
                    <div class="font-mono-label text-xs text-primary mb-4 flex items-center gap-2">
                        <span class="w-2 h-2 bg-primary inline-block"></span>
                        {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </div>
                    <h1 class="font-headline text-3xl md:text-5xl text-on-surface uppercase mb-6 leading-tight">
                        {post.data.title}
                    </h1>
                </header>
                
                <div class="prose max-w-none">
                    <Content />
                </div>
            </article>
        </div>
    </main>
    
    <Footer />
</Layout>

<style is:global>
    .prose {
        color: var(--color-on-surface);
        line-height: 1.6;
        font-family: var(--font-code);
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .prose h1, .prose h2, .prose h3, .prose h4 {
        color: var(--color-primary);
        margin-top: 2rem;
        margin-bottom: 1rem;
        font-family: var(--font-headline);
        text-transform: uppercase;
        font-weight: normal;
    }
    .prose h1 { font-size: 2.25rem; }
    .prose h2 { font-size: 1.875rem; }
    .prose h3 { font-size: 1.5rem; }
    .prose p {
        margin-bottom: 1.25rem;
    }
    .prose a {
        color: var(--color-primary);
        text-decoration: underline;
        text-decoration-color: var(--color-primary-container);
        text-underline-offset: 4px;
    }
    .prose a:hover {
        background-color: var(--color-primary);
        color: var(--color-background);
    }
    .prose ul, .prose ol {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
    }
    .prose ul { list-style-type: square; }
    .prose ol { list-style-type: decimal; }
    .prose li { margin-bottom: 0.5rem; }
    .prose strong { color: var(--color-on-surface); font-weight: bold; }
    .prose blockquote {
        border-left: 4px solid var(--color-primary);
        padding-left: 1rem;
        font-style: italic;
        color: var(--color-on-surface-variant);
        margin-bottom: 1.5rem;
    }
</style>
