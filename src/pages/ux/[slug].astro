---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Parser from 'rss-parser';

export async function getStaticPaths() {
    let articles = [];
    try {
        const parser = new Parser();
        const feed = await parser.parseURL('https://medium.com/feed/@alexgmatosc');
        articles = feed.items;
    } catch (e) {
        console.error("Error fetching Medium RSS", e);
    }

    const paths = articles.map((article) => {
        // Create a slug from the title
        const slug = article.title
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/(^-|-$)+/g, '');

        return {
            params: { slug },
            props: { article }
        };
    });

    return paths;
}

const { article } = Astro.props;
---

<Layout title={`alexmatos.dev | ${article.title}`} description={article.contentSnippet}>
    <Header lang="es" />
    <main class="w-full pt-32 min-h-screen">
        <div class="max-w-[1000px] mx-auto px-gutter py-12">
            
            <a href="/#ux" class="inline-flex items-center gap-2 font-mono-label text-primary hover:text-on-surface transition-colors mb-8 group">
                <Icon name="material-symbols:arrow-back" class="text-lg group-hover:-translate-x-1 transition-transform" />
                VOLVER AL INICIO
            </a>

            <!-- Header -->
            <div class="bg-surface border-4 border-primary p-8 md:p-12 relative mb-12">
                <div class="absolute -top-4 -left-4 bg-primary text-background font-mono-label px-3 py-1 uppercase tracking-widest text-sm">UX_LOG</div>
                <div class="absolute top-4 right-4 w-8 h-8 border-t-2 border-r-2 border-primary/40 pointer-events-none hidden sm:block"></div>
                <div class="absolute bottom-4 left-4 w-8 h-8 border-b-2 border-l-2 border-primary/40 pointer-events-none hidden sm:block"></div>
                
                <h1 class="font-headline-lg text-4xl md:text-5xl text-on-surface uppercase mb-6 tracking-tighter leading-tight">
                    {article.title}
                </h1>
                
                <div class="flex flex-wrap gap-6 items-center">
                    <span class="font-mono-label bg-background border-2 border-primary px-4 py-2 text-on-surface uppercase">
                        MEDIUM ARTICLE
                    </span>
                    <span class="font-mono-label text-on-surface-variant flex items-center gap-2">
                        <Icon name="material-symbols:calendar-today" class="text-base" /> 
                        {new Date(article.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </span>
                    {article.categories && article.categories.length > 0 && (
                        <span class="font-mono-label text-primary/70">
                            [{article.categories.slice(0, 3).join(', ')}]
                        </span>
                    )}
                </div>
            </div>

            <!-- Content Area -->
            <article class="content-area article-content bg-surface border-4 border-primary p-8 md:p-12 relative">
                <div class="absolute -top-3 -right-3 bg-background text-primary font-mono-label px-3 py-1 text-sm border-2 border-primary">CONTENT_STREAM</div>
                
                <div class="prose max-w-none prose-invert dark:prose-invert" set:html={article['content:encoded'] || article.content}></div>
            </article>

            <!-- External Link Button -->
            <div class="mt-12">
                <a href={article.link} target="_blank" rel="noopener noreferrer" class="w-full relative overflow-hidden bg-background text-on-surface border-4 border-primary font-mono-label py-6 uppercase transition-colors block text-center text-xl group-hover:bg-primary group-hover:text-background flex justify-center items-center gap-4 group">
                    <span class="absolute inset-0 bg-primary/20 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300"></span>
                    <span class="relative z-10 flex items-center gap-4 group-hover:text-primary">
                        LEER EN MEDIUM <Icon name="material-symbols:open-in-new"  />
                    </span>
                </a>
            </div>
            
        </div>
    </main>
    <Footer />
</Layout>

<style is:global>
    /* Estilos específicos para el HTML inyectado de Medium */
    .article-content img {
        max-width: 100%;
        height: auto;
        border: 2px solid var(--primary);
        margin: 2rem 0;
    }
    .article-content p {
        font-family: var(--font-code-body);
        font-size: 1.125rem;
        line-height: 1.7;
        margin-bottom: 1.5rem;
        color: var(--on-surface);
    }
    .article-content h1, .article-content h2, .article-content h3, .article-content h4 {
        font-family: var(--font-headline-lg);
        text-transform: uppercase;
        color: var(--on-surface);
        margin-top: 3rem;
        margin-bottom: 1.5rem;
    }
    .article-content h2 { font-size: 2.5rem; }
    .article-content h3 { font-size: 2rem; }
    .article-content a {
        color: var(--primary);
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .article-content a:hover {
        background-color: var(--primary);
        color: var(--background);
        text-decoration: none;
    }
    .article-content blockquote {
        border-left: 4px solid var(--primary);
        padding-left: 1.5rem;
        font-style: italic;
        color: var(--on-surface-variant);
        background-color: var(--surface-variant);
        padding: 1.5rem;
        margin: 2rem 0;
    }
    .article-content figure {
        margin: 2rem 0;
    }
    .article-content figcaption {
        font-family: var(--font-mono-label);
        font-size: 0.875rem;
        text-align: center;
        color: var(--on-surface-variant);
        margin-top: 0.5rem;
    }
    .article-content ul, .article-content ol {
        margin-bottom: 1.5rem;
        padding-left: 2rem;
        font-family: var(--font-code-body);
        color: var(--on-surface);
    }
    .article-content li {
        margin-bottom: 0.5rem;
    }
    .article-content pre {
        background-color: #111;
        border: 1px solid var(--primary);
        padding: 1.5rem;
        overflow-x: auto;
        margin: 2rem 0;
        color: #fff;
    }
    .article-content code {
        font-family: monospace;
        background-color: var(--surface-variant);
        padding: 0.2rem 0.4rem;
        color: var(--primary);
    }
</style>
