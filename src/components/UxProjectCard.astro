---
export interface Props {
    title: string;
    description: string;
    link: string;
    icon: string;
    caseId: string;
    reverseOrder?: boolean;
}

const { title, description, link, icon, caseId, reverseOrder = false } = Astro.props;
---
<div class="group bg-background hover:translate-x-3 hover:-translate-y-3 transition-all flex flex-col lg:flex-row items-stretch relative overflow-hidden">
    <div class="absolute inset-0 scanlines opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity z-0 bg-primary/10"></div>
    
    <div class={`w-full lg:w-1/3 flex flex-col justify-center items-center border-b-4 lg:border-b-0 lg:border-r-4 border-primary bg-primary p-8 ${reverseOrder ? 'lg:order-last lg:border-r-0 lg:border-l-4' : ''} z-10`}>
        <span class="material-symbols-outlined text-[120px] text-background group-hover:animate-pulse">{icon}</span>
        <div class="font-mono-label text-background mt-4 uppercase tracking-widest text-center border-t-2 border-background pt-2">MED_ARTICLE_{caseId}</div>
    </div>
    
    <div class="w-full lg:w-2/3 p-8 lg:p-12 z-10 bg-surface flex flex-col justify-center relative">
        <!-- Cyberpunk Decorations -->
        <div class="absolute top-4 right-4 w-8 h-8 border-t-2 border-r-2 border-primary/40 pointer-events-none hidden sm:block"></div>
        <div class="absolute bottom-4 right-4 w-8 h-8 border-b-2 border-r-2 border-primary/40 pointer-events-none hidden sm:block"></div>
        <div class="absolute -top-3 -right-3 bg-background text-primary font-mono-label px-2 py-1 text-xs border-2 border-primary z-20 hidden sm:block">UX_LOG</div>

        <h3 class="font-headline-lg text-3xl md:text-5xl text-on-surface uppercase mb-6 max-w-full overflow-hidden text-ellipsis line-clamp-2 border-l-8 border-primary pl-6">
            {title}
        </h3>
        
        <div class="bg-background border border-primary/30 p-6 mb-8 flex-grow">
            <p class="font-code-body text-lg text-on-surface leading-relaxed line-clamp-4">
                {description}
            </p>
        </div>
        
        <a href={link} class="self-start bg-background hover:bg-primary text-on-surface hover:text-background border-t-2 border-primary/30 font-mono-label px-10 py-5 uppercase transition-colors inline-flex items-center gap-4 text-xl hover:translate-x-1 hover:translate-y-1">
            LEER ARTÍCULO <span class="material-symbols-outlined">north_east</span>
        </a>
    </div>
</div>
