---
import { Icon } from 'astro-icon/components';
import { getI18n } from '../data/portfolioData';
import Logo from './Logo.astro';

export interface Props {
    lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const i18n = getI18n(lang);
const base = lang === 'en' ? '/en/' : '/';

// Helpers for language toggle links
const currentPath = Astro.url.pathname;
const esLink = currentPath.startsWith('/en') ? currentPath.replace(/^\/en\/?/, '/') || '/' : currentPath;
const enLink = currentPath.startsWith('/en') ? currentPath : `/en${currentPath === '/' ? '' : currentPath}`;
---
<header class="fixed top-0 w-full z-50 bg-background border-b-border-thick border-primary-container">
    <div class="h-20 w-full px-gutter flex items-center justify-between">
        <div class="flex items-center gap-grid-unit">
            <div class="p-2">
                <a href={base} class="block transition-transform hover:scale-105" aria-label="Inicio">
                    <Logo class="w-12 h-12 text-on-surface fill-current" />
                </a>
            </div>
        </div>
        <nav class="hidden md:flex flex-col md:flex-row absolute md:relative top-20 md:top-0 left-0 w-full md:w-auto bg-background md:bg-transparent border-b-4 border-primary md:border-none items-stretch md:items-center h-auto md:h-full p-0 shadow-lg md:shadow-none z-40" id="main-nav">
            <a aria-current="page" class="nav-link w-full md:w-auto py-4 md:py-0 h-auto md:h-full px-6 flex items-center font-mono-label transition-all border-b-border-thin md:border-b-0 md:border-l-border-thin border-primary-container/30 uppercase border-l-4 md:border-l-0 md:border-b-4 border-primary md:text-on-surface text-primary bg-primary/10 md:bg-transparent" href={`${base}#inicio`}>{i18n.nav.home}</a>
            <a class="nav-link w-full md:w-auto py-4 md:py-0 h-auto md:h-full px-6 flex items-center font-mono-label transition-all border-b-border-thin md:border-b-0 md:border-l-border-thin border-primary-container/30 uppercase border-l-4 md:border-l-0 md:border-b-4 border-transparent text-on-surface-variant hover:bg-surface-variant hover:text-on-surface" href={`${base}#sobre-mi`}>{i18n.nav.about}</a>
            <a class="nav-link w-full md:w-auto py-4 md:py-0 h-auto md:h-full px-6 flex items-center font-mono-label transition-all border-b-border-thin md:border-b-0 md:border-l-border-thin border-primary-container/30 uppercase border-l-4 md:border-l-0 md:border-b-4 border-transparent text-on-surface-variant hover:bg-surface-variant hover:text-on-surface" href={`${base}#dev`}>{i18n.nav.dev}</a>
            <a class="nav-link w-full md:w-auto py-4 md:py-0 h-auto md:h-full px-6 flex items-center font-mono-label transition-all border-b-border-thin md:border-b-0 md:border-l-border-thin border-primary-container/30 uppercase border-l-4 md:border-l-0 md:border-b-4 border-transparent text-on-surface-variant hover:bg-surface-variant hover:text-on-surface" href={`${base}#ux`}>{i18n.nav.ux}</a>
            <a class="nav-link w-full md:w-auto py-4 md:py-0 h-auto md:h-full px-6 flex items-center font-mono-label transition-all border-b-border-thin md:border-b-0 md:border-l-border-thin md:border-r-border-thin border-primary-container/30 uppercase border-l-4 md:border-l-0 md:border-b-4 border-transparent text-on-surface-variant hover:bg-surface-variant hover:text-on-surface" href={`${base}#contacto`}>{i18n.nav.contact}</a>
            <div class="ml-0 md:ml-6 p-6 md:p-0 flex items-center gap-4">
                <button id="theme-toggle" class="text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center" aria-label="Toggle theme">
                    <Icon name="material-symbols:light-mode" id="theme-icon" />
                </button>
                <div class="flex items-center gap-2 font-mono-label text-sm uppercase">
                    <a href={esLink} class={`transition-colors ${lang === 'es' ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface'}`}>ES</a>
                    <span class="text-on-surface-variant/50">|</span>
                    <a href={enLink} class={`transition-colors ${lang === 'en' ? 'text-primary' : 'text-on-surface-variant hover:text-on-surface'}`}>EN</a>
                </div>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center hidden sm:flex">
                    <Icon name="material-symbols:person" class="text-background text-[18px]" />
                </div>
            </div>
        </nav>
        <button id="mobile-menu-btn" class="md:hidden text-primary hover:text-on-surface transition-colors" aria-label="Toggle mobile menu"><Icon name="material-symbols:menu" class="text-[32px]" /></button>
    </div>
</header>

<script is:inline>
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeIcon = document.getElementById('theme-icon');

    function updateIcon() {
        if (document.documentElement.classList.contains('light')) {
            themeIcon.textContent = 'dark_mode';
        } else {
            themeIcon.textContent = 'light_mode';
        }
    }

    if (themeToggleBtn) {
        updateIcon();
        themeToggleBtn.addEventListener('click', function() {
            document.documentElement.classList.toggle('light');
            
            if (document.documentElement.classList.contains('light')) {
                localStorage.setItem('theme', 'light');
            } else {
                localStorage.setItem('theme', 'dark');
            }
            updateIcon();
        });
    }

    // Scroll spy logic
    document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -70% 0px',
            threshold: 0
        };

        const navLinks = document.querySelectorAll('.nav-link');
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mainNav = document.getElementById('main-nav');

        if (mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', () => {
                mainNav.classList.toggle('hidden');
                mainNav.classList.toggle('flex');
            });
            // Close mobile menu on click
            navLinks.forEach(link => {
                link.addEventListener('click', () => {
                    if (window.innerWidth < 768) {
                        mainNav.classList.add('hidden');
                        mainNav.classList.remove('flex');
                    }
                });
            });
        }

        const sections = Array.from(navLinks).map(link => {
            const id = link.getAttribute('href').substring(1);
            return document.getElementById(id);
        }).filter(Boolean);

        // En mobile la clase activa es border-l-4 y bg-primary/10, en desktop border-b-4
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    navLinks.forEach(link => {
                        if (link.getAttribute('href') === `#${entry.target.id}`) {
                            // Desktop active
                            link.classList.add('md:border-b-4', 'md:border-primary', 'md:text-on-surface');
                            link.classList.remove('md:border-transparent', 'md:text-on-surface-variant');
                            // Mobile active
                            link.classList.add('border-primary', 'text-primary', 'bg-primary/10');
                            link.classList.remove('border-transparent', 'text-on-surface-variant');
                            
                            link.setAttribute('aria-current', 'page');
                        } else {
                            // Desktop inactive
                            link.classList.remove('md:border-primary', 'md:text-on-surface');
                            link.classList.add('md:border-transparent', 'md:text-on-surface-variant');
                            // Mobile inactive
                            link.classList.remove('border-primary', 'text-primary', 'bg-primary/10');
                            link.classList.add('border-transparent', 'text-on-surface-variant');
                            
                            link.removeAttribute('aria-current');
                        }
                    });
                }
            });
        }, observerOptions);

        sections.forEach(section => observer.observe(section));
    });
</script>
