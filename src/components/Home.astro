---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import UxProjectCard from '../components/UxProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import Logo from '../components/Logo.astro';
import Parser from 'rss-parser';
import { portfolioData, getI18n } from '../data/portfolioData';

export interface Props {
    lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const i18n = getI18n(lang);

let repos = [];
let schoolRepos = [];
try {
    const token = import.meta.env.GITHUB_TOKEN || process.env.GITHUB_TOKEN;
    const headers = token ? { 'Authorization': `Bearer ${token}` } : {};
    
    // Diccionario de fallbacks por si la API falla o llega al límite
    const fallbacks = {
        'stories.io': { name: 'stories.io', description: 'Generador de videos para redes sociales.', language: 'TypeScript', html_url: 'https://github.com/Alexgmatosc/stories.io' },
        'homehub': { name: 'homehub', description: 'Plataforma de gestión del hogar.', language: 'TypeScript', html_url: 'https://github.com/Alexgmatosc/homehub' },
        'roomie-detector': { name: 'roomie-detector', description: 'App para encontrar compañeros de piso.', language: 'React', html_url: 'https://github.com/Alexgmatosc/roomie-detector' },
        'el-rastro-e-comerce': { name: 'el-rastro-e-comerce', description: 'Web para e-commerce que vende ropa online.', language: 'JavaScript', html_url: 'https://github.com/Alexgmatosc/el-rastro-e-comerce' },
        'brutalist-portfolio': { name: 'brutalist-portfolio', description: 'Portafolio personal brutalista.', language: 'Astro', html_url: 'https://github.com/Alexgmatosc/brutalist-portfolio' },
        '42-ft_Printf': { name: '42-ft_Printf', description: 'Custom printf implementation.', language: 'C', html_url: 'https://github.com/Alexgmatosc/42-ft_Printf' },
        '42-Libft': { name: '42-Libft', description: 'Custom C library.', language: 'C', html_url: 'https://github.com/Alexgmatosc/42-Libft' },
        'get-next-line': { name: 'get-next-line', description: 'Function that reads a file line by line.', language: 'C', html_url: 'https://github.com/Alexgmatosc/get-next-line' }
    };

    // Proyectos a recuperar desde GitHub
    const repoNames = ['stories.io', 'homehub', 'roomie-detector', 'el-rastro-e-comerce', 'brutalist-portfolio'];
    const fetchedRepos = [];
    for (const name of repoNames) {
        const res = await fetch(`https://api.github.com/repos/Alexgmatosc/${name}`, { headers });
        if (res.ok) {
            fetchedRepos.push(await res.json());
        } else {
            fetchedRepos.push(fallbacks[name]);
        }
    }

    // Sub-proyectos de 42
    const subRepoNames = ['42-ft_Printf', '42-Libft', 'get-next-line'];
    const subRepos = [];
    for (const name of subRepoNames) {
        const res = await fetch(`https://api.github.com/repos/Alexgmatosc/${name}`, { headers });
        let data = res.ok ? await res.json() : fallbacks[name];
        subRepos.push(data);
    }

    // Export variables para el frontend
    repos = fetchedRepos;
    schoolRepos = subRepos;
} catch (e) {
    console.error("Error fetching repos", e);
    // Diccionario de fallbacks replicado por si falla toda la conexión
    repos = [
        { name: 'stories.io', description: 'Generador de videos para redes sociales.', language: 'TypeScript', html_url: 'https://github.com/Alexgmatosc/stories.io' },
        { name: 'homehub', description: 'Plataforma de gestión del hogar.', language: 'TypeScript', html_url: 'https://github.com/Alexgmatosc/homehub' },
        { name: 'roomie-detector', description: 'App para encontrar compañeros de piso.', language: 'React', html_url: 'https://github.com/Alexgmatosc/roomie-detector' },
        { name: 'el-rastro-e-comerce', description: 'Web para e-commerce que vende ropa online.', language: 'JavaScript', html_url: 'https://github.com/Alexgmatosc/el-rastro-e-comerce' },
        { name: 'brutalist-portfolio', description: 'Portafolio personal brutalista.', language: 'Astro', html_url: 'https://github.com/Alexgmatosc/brutalist-portfolio' }
    ];
    schoolRepos = [
        { name: '42-ft_Printf', description: 'Custom printf implementation.', language: 'C', html_url: 'https://github.com/Alexgmatosc/42-ft_Printf' },
        { name: '42-Libft', description: 'Custom C library.', language: 'C', html_url: 'https://github.com/Alexgmatosc/42-Libft' },
        { name: 'get-next-line', description: 'Function that reads a file line by line.', language: 'C', html_url: 'https://github.com/Alexgmatosc/get-next-line' }
    ];
}

let articles = [];
try {
    const parser = new Parser();
    const feed = await parser.parseURL('https://medium.com/feed/@alexgmatosc');
    articles = feed.items.slice(0, 3);
} catch (e) {
    console.error("Error fetching Medium RSS", e);
}
---

<Layout lang={lang}>
    <Header lang={lang} />
    
    <main class="w-full pt-20 min-h-screen">
        <div class="flex flex-col w-full">
            <!-- Grid Background overlay (Brutalist visible lines) -->
            <div class="fixed inset-0 pointer-events-none grid grid-cols-4 md:grid-cols-12 gap-0 border-l-[1px] border-r-[1px] border-primary/20 opacity-50 mix-blend-multiply dark:mix-blend-screen" style="z-index:-1;">
                <div class="border-r-[1px] border-primary/20 h-full"></div>
                <div class="border-r-[1px] border-primary/20 h-full"></div>
                <div class="border-r-[1px] border-primary/20 h-full"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
                <div class="border-r-[1px] border-primary/20 h-full hidden md:block"></div>
            </div>

            <!-- Hero Section -->
            <section class="min-h-[100svh] relative flex flex-col px-gutter border-b-border-thick border-primary-container bg-surface overflow-hidden pt-24 pb-12 md:py-32 bg-grid-pattern" id="inicio">
                <div class="absolute inset-0 scanlines pointer-events-none opacity-50 z-0"></div>
                <div class="absolute top-1/4 left-10 font-mono-label text-primary/30 text-xs hidden lg:block whitespace-pre z-0">
+--------------------+
| DATA_STREAM_ACTIVE |
| 010101010111000101 |
| 110100010101011110 |
+--------------------+
                </div>
                <div class="absolute bottom-1/4 right-10 font-mono-label text-primary/30 text-xs hidden lg:block whitespace-pre text-right z-0">
[ NODE_CONNECTION: STABLE ]
+===-------------+ [98%]
LATENCY: 12ms
                </div>
                <div class="absolute inset-y-0 left-1/4 w-[1px] acid-border hidden md:block z-0"></div>
                <div class="absolute inset-x-0 top-1/3 h-[1px] acid-border hidden md:block z-0"></div>
                
                <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-gutter w-full mt-4 mb-auto md:my-auto">
                    <div class="md:col-span-10 md:col-start-1 lg:col-span-9 lg:col-start-2 border-border-thick border-primary-container bg-surface p-6 sm:p-12 relative">
                        <div class="absolute -top-4 -left-4 bg-primary text-background font-mono-label px-2 py-1 uppercase tracking-widest text-sm z-20">SYS_INIT_001</div>
                        <div class="absolute -bottom-4 -right-4 bg-surface text-primary font-mono-label px-2 py-1 border-border-thick border-primary-container z-20">V. 4.0.9</div>
                        
                        <!-- Hero composition logo -->
                        <div class="absolute inset-0 overflow-hidden pointer-events-none z-0 rounded-sm">
                            <div class="absolute right-[-20%] lg:right-[-10%] top-1/2 -translate-y-1/2 opacity-10">
                                <Logo class="w-[500px] h-[500px] lg:w-[700px] lg:h-[700px] xl:w-[900px] xl:h-[900px] text-primary fill-current" />
                            </div>
                        </div>

                        <div class="relative z-10">
                            <h1 class="font-headline-xl text-on-surface leading-[0.85] tracking-tighter">
                                <span class="block text-[60px] sm:text-[80px] md:text-[100px] lg:text-[140px] xl:text-[180px] uppercase font-pirata tracking-wide md:tracking-[0.05em] leading-[0.9]">{i18n.hero.firstName}</span>
                                <span class="block text-[60px] sm:text-[80px] md:text-[100px] lg:text-[140px] xl:text-[180px] uppercase font-pirata tracking-wide md:tracking-[0.05em] leading-[0.9]">{i18n.hero.lastName}</span>
                                <span class="flex flex-wrap items-baseline gap-2 md:gap-4 ml-0 sm:ml-12 mt-0 md:-mt-4 text-on-surface">
                                    <span class="text-4xl md:text-5xl lg:text-7xl tracking-widest uppercase">{i18n.hero.roles[0]}</span>
                                    <span class="text-3xl md:text-4xl lg:text-5xl text-primary opacity-80">&amp;</span>
                                    <span class="text-4xl sm:text-6xl md:text-[70px] lg:text-[90px] tracking-tighter">{i18n.hero.roles[1]}</span>
                                </span>
                            </h1>
                            
                            <p class="mt-8 font-code-body text-code-body text-on-surface-variant max-w-2xl border-l-[2px] border-primary pl-4 tracking-tight" set:html={i18n.hero.description.join('<br/>')} />
                            
                            <div class="mt-12 flex flex-col sm:flex-row gap-6 relative z-20">
                                <a href="#dev" class="bg-primary hover:bg-surface text-background hover:text-primary border-border-thick border-primary hover:border-primary-container font-mono-label px-8 py-4 uppercase transition-colors flex items-center justify-center gap-2 group hover:translate-x-1 hover:translate-y-1">
                                    <Icon name="material-symbols:terminal" class="text-lg group-hover:animate-pulse" />
                                    {i18n.hero.buttons.projects}
                                </a>
                                <a href="#contacto" class="bg-surface hover:bg-primary-container text-on-surface hover:text-background border-border-thick border-primary-container font-mono-label px-8 py-4 uppercase transition-colors flex items-center justify-center gap-2 group relative overflow-hidden">
                                    <span class="absolute inset-0 bg-primary/20 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300"></span>
                                    <span class="relative z-10 flex items-center gap-2">
                                        <Icon name="material-symbols:mail" class="text-lg" />
                                        {i18n.hero.buttons.contact}
                                    </span>
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- Decorative Sidebar -->
                    <div class="hidden md:flex col-span-2 col-start-11 border-l-border-thick border-primary-container flex-col justify-between p-4 bg-surface relative z-10">
                        <div class="w-full flex justify-center mb-8">
                            <Logo class="w-16 h-16 text-primary opacity-80 fill-current animate-pulse" />
                        </div>
                        <p class="font-mono-label text-primary [writing-mode:vertical-rl] rotate-180 uppercase tracking-widest opacity-70">
                            [ STATUS: OPERATIONAL ] // OVERRIDE CODE: A7X9
                        </p>
                    </div>
                </div>
            </section>

            <!-- Sobre Mí -->
            <section class="py-24 px-gutter border-b-border-thick border-primary-container relative bg-grid-pattern" id="sobre-mi">
                <div class="absolute inset-0 scanlines pointer-events-none opacity-30 z-0"></div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter max-w-[1600px] mx-auto">
                    <!-- Header Column -->
                    <div class="lg:col-span-4 relative z-10">
                        <div class="sticky top-28 bg-surface-container border-border-thick border-primary-container p-6">
                            <h2 class="font-display-lg text-headline-lg text-on-surface uppercase mb-4">Sobre_Mí</h2>
                            <div class="mt-4 h-1 w-full bg-primary-container"></div>
                            <p class="mt-6 font-code-body text-code-body text-on-surface-variant">
                                {i18n.about.sidebarIntro}
                            </p>
                            <div class="mt-8 bg-surface border-border-thick border-primary p-4 h-[300px] flex flex-col justify-center items-center">
                                <div class="font-mono-label text-primary text-center">
<pre class="text-[8px] leading-tight opacity-70 hidden sm:block">      /\
     /  \
    /____\
   /      \
  /________\
 /          \
/____________\
</pre>
                                    <div class="mt-4 text-sm animate-pulse">[ PROFILE_IMG_MISSING ]</div>
                                    <div class="text-xs mt-2 opacity-50">FALLBACK_RENDER_ACTIVE</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Content Column -->
                    <div class="lg:col-span-8 lg:pl-12 flex flex-col gap-12 mt-12 lg:mt-0 relative z-10">
                        <!-- Bio -->
                        <div class="bg-surface border-border-thick border-primary-container p-8 relative overflow-hidden">
                            <div class="absolute right-0 top-0 w-32 h-32 bg-primary/10 blur-3xl rounded-full mix-blend-multiply dark:mix-blend-screen"></div>
                            <div class="font-mono-label text-on-surface-variant mb-4 border-l-2 border-primary pl-2 inline-block">_USER_BIO.TXT</div>
                            <div class="font-code-body text-code-body text-on-surface leading-relaxed space-y-4">
                                {i18n.about.bioParagraphs.map(paragraph => (
                                    <p>{paragraph}</p>
                                ))}
                            </div>
                            <div class="mt-6 font-terminal-small text-secondary flex items-center gap-2">
                                <span class="w-3 h-3 bg-primary animate-pulse inline-block"></span>
                                SYSTEM_UPTIME: 98.9%
                            </div>
                        </div>
                        
                        <!-- Skills Grid -->
                        <div class="bg-surface border-border-thick border-primary p-8">
                            <div class="font-mono-label text-on-surface-variant mb-6 border-l-2 border-primary pl-2 inline-block">_SKILL_TREE.INI</div>
                            
                            <div class="mb-4">
                                <h3 class="font-mono-label text-primary mb-3"># DEV_MODULES</h3>
                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                                    {i18n.about.devSkills.map(skill => (
                                        <div class="bg-surface-container-high border-border-thin border-primary text-on-surface font-mono-label p-3 text-center uppercase hover:bg-primary hover:text-background transition-colors cursor-crosshair">{skill}</div>
                                    ))}
                                </div>
                            </div>

                            <div class="mt-8">
                                <h3 class="font-mono-label text-on-surface mb-3"># UX_MODULES</h3>
                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                                    {i18n.about.uxSkills.map(skill => (
                                        <div class="bg-surface-container-high border-border-thin border-on-surface text-on-surface font-mono-label p-3 text-center uppercase hover:bg-on-surface hover:text-background transition-colors cursor-crosshair">{skill}</div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- DEV PROJECTS -->
            <section class="py-24 px-gutter border-b-border-thick border-primary-container relative bg-grid-pattern" id="dev">
                <div class="absolute inset-0 scanlines pointer-events-none opacity-30 z-0"></div>
                <div class="max-w-[1600px] mx-auto relative z-10">
                    <div class="flex items-end mb-12 border-b-border-thick border-primary pb-4">
                        <h2 class="font-headline-xl text-5xl md:text-headline-xl text-on-surface uppercase m-0 leading-none break-words">{i18n.sections.devTitle}</h2>
                    </div>
                    
                    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter mb-12">
                        {repos.length > 0 ? repos.map((repo, idx) => (
                            <ProjectCard 
                                title={repo.name}
                                description={repo.description}
                                languages={repo.language ? [repo.language] : ['Unknown']}
                                repoUrl={lang === 'en' ? `/en/dev/${repo.name}` : `/dev/${repo.name}`}
                                repoId={String(idx + 1).padStart(3, '0')}
                            />
                        )) : (
                            <p class="font-mono-label text-on-surface-variant">No se pudieron cargar los repositorios o el usuario no tiene repositorios públicos.</p>
                        )}
                    </ul>

                    <!-- 42 School Section -->
                    <div class="border-2 border-primary p-6 md:p-8 bg-surface-container relative mt-16">
                        <div class="absolute -top-4 left-6 bg-primary text-background font-mono-label px-3 py-1 text-sm z-10 uppercase">
                            42 School Core Curriculum
                        </div>
                        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
                            {schoolRepos.map((repo, idx) => (
                                <ProjectCard 
                                    title={repo.name}
                                    description={repo.description}
                                    languages={repo.language ? [repo.language] : ['Unknown']}
                                    repoUrl={lang === 'en' ? `/en/dev/${repo.name}` : `/dev/${repo.name}`}
                                    repoId={`42-${String(idx + 1).padStart(2, '0')}`}
                                />
                            ))}
                        </ul>
                    </div>
                </div>
            </section>

            <!-- UX DESIGN (Medium) -->
            <section class="py-24 px-gutter border-b-border-thick border-primary-container relative bg-grid-pattern" id="ux">
                <div class="absolute inset-0 scanlines pointer-events-none opacity-30 z-0"></div>
                <div class="max-w-[1600px] mx-auto relative z-10">
                    <div class="flex items-end mb-12 border-b-border-thick border-primary pb-4">
                        <h2 class="font-headline-xl text-5xl md:text-headline-xl text-on-surface uppercase m-0 leading-none break-words">{i18n.sections.uxTitle}</h2>
                    </div>
                    <div class="flex flex-col gap-12">
                        {articles.length > 0 ? articles.map((article, idx) => {
                            const icons = ['visibility', 'touch-app', 'design-services', 'architecture'];
                            const slug = article.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
                            return (
                                <UxProjectCard 
                                    title={article.title}
                                    description={article.contentSnippet ? article.contentSnippet.substring(0, 150) + '...' : 'Read full article...'}
                                    link={lang === 'en' ? `/en/ux/${slug}` : `/ux/${slug}`}
                                    icon={icons[idx % icons.length]}
                                    caseId={String(idx + 1).padStart(2, '0')}
                                    reverseOrder={idx % 2 !== 0}
                                />
                            );
                        }) : (
                            <p class="font-mono-label text-on-surface-variant">No se pudieron cargar los artículos de Medium o no hay publicaciones recientes.</p>
                        )}
                    </div>
                </div>
            </section>

            <ContactForm lang={lang} />
        </div>
    </main>

    <Footer />
</Layout>
