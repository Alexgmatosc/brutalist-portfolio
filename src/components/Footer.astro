---
import Logo from './Logo.astro';
---
<footer class="w-full bg-surface-container border-t-border-thick border-primary-container relative overflow-hidden mt-24" id="contacto">
    <div class="absolute inset-0 bg-grid-pattern opacity-20 pointer-events-none"></div>
    <div class="w-full px-gutter py-12 flex flex-col md:flex-row justify-between items-center gap-8 relative z-10">
        <div class="w-full md:flex-1 flex justify-center md:justify-start font-mono-label text-mono-label text-on-surface-variant uppercase text-center md:text-left">
            [ STATUS: ONLINE ] [ SEC_LEVEL: 04 ]
        </div>
        <div class="w-full md:flex-1 flex justify-center items-center gap-2 font-mono-label text-mono-label text-on-surface-variant uppercase">
            © <span id="current-year"></span> <Logo class="w-6 h-6 inline-block text-on-surface fill-current" /> ALL RIGHTS RESERVED.
        </div>
        <div class="w-full md:flex-1 flex justify-center md:justify-end gap-6 font-mono-label text-sm uppercase">
            <a href="https://github.com/Alexgmatosc" target="_blank" rel="noopener noreferrer" class="text-primary-container hover:text-primary transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[18px]">terminal</span>
                Github
            </a>
            <a href="https://www.linkedin.com/in/alematos-/" target="_blank" rel="noopener noreferrer" class="text-primary-container hover:text-primary transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[18px]">work</span>
                LinkedIn
            </a>
            <a href="https://medium.com/" target="_blank" rel="noopener noreferrer" class="text-primary-container hover:text-primary transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[18px]">article</span>
                Medium
            </a>
        </div>
    </div>
</footer>

<script is:inline>
    document.getElementById('current-year').textContent = new Date().getFullYear();
</script>
