---
import Logo from './Logo.astro';
---
<footer class="w-full bg-surface-container border-t-border-thick border-primary-container relative overflow-hidden mt-24" id="contacto">
    <div class="absolute inset-0 bg-grid-pattern opacity-20 pointer-events-none"></div>
    <div class="w-full px-gutter py-12 flex flex-col md:flex-row justify-between items-center gap-stack-gap relative z-10">
        <div class="font-mono-label text-mono-label text-on-surface-variant uppercase">[ STATUS: ONLINE ] [ SEC_LEVEL: 04 ]</div>
        <div class="font-mono-label text-mono-label text-on-surface-variant uppercase flex items-center gap-2">© 2024 <Logo class="w-6 h-6 inline-block text-on-surface fill-current" />. ALL RIGHTS RESERVED.</div>
        <div class="flex gap-gutter">
            <a href="https://github.com/Alexgmatosc" target="_blank" rel="noopener noreferrer" class="material-symbols-outlined text-primary-container cursor-pointer hover:text-primary transition-colors">terminal</a>
            <span class="material-symbols-outlined text-primary-container cursor-pointer hover:text-primary transition-colors">database</span>
            <span class="material-symbols-outlined text-primary-container cursor-pointer hover:text-primary transition-colors">share</span>
        </div>
    </div>
</footer>
